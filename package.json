{
  "name": "@ubc-biztech/sdk",
  "version": "0.10.0",
  "description": "Typed, chained client for BizTech club data, generated from one declaration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubc-biztech/sdk.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "gen": "tsx scripts/generate.ts",
    "check:semver": "tsx scripts/semver.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:contract": "BT_CONTRACT=1 vitest run test/contract.test.ts",
    "ci": "npm run gen && npm run typecheck && npm test && npm run build && git diff --exit-code -- src/generated docs",
    "check": "tsx scripts/check.ts",
    "new": "tsx scripts/new.ts"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
