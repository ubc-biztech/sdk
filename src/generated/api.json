{
  "roles": {
    "public": {
      "credential": "none",
      "description": "No credential. Anyone on the internet."
    },
    "judgingCode": {
      "credential": "code",
      "description": "Any code the event knows: a team's or a judge's. Row-level filtering (a team sees only its own reviews) is the backend's job."
    },
    "judge": {
      "credential": "code",
      "implies": [
        "judgingCode"
      ],
      "description": "A judge's code for the event. A team code gets 403."
    },
    "admin": {
      "credential": "token",
      "description": "A Cognito ID token for a BizTech exec (today: a verified @ubcbiztech.com email). Not a code."
    }
  },
  "entities": {
    "JudgingEvent": {
      "name": "JudgingEvent",
      "description": "Everything about one event's judging except the reviews. One backend row, read and replaced whole.",
      "fields": {
        "me": {
          "kind": "ref",
          "entity": "JudgingPrincipal",
          "optional": true,
          "description": "The caller. Present on `get` (with a code); absent on the admin actions."
        },
        "updatedAt": {
          "kind": "string",
          "description": "ISO-8601, set by the backend on every write."
        },
        "settings": {
          "kind": "ref",
          "entity": "JudgingSettings",
          "description": "Phase and switches."
        },
        "rubric": {
          "kind": "ref",
          "entity": "Rubric",
          "nullable": true,
          "description": "The rubric, or null before one is set."
        },
        "links": {
          "kind": "array",
          "items": {
            "kind": "ref",
            "entity": "JudgingLink",
            "description": "A link."
          },
          "description": "Home-page links, in order."
        },
        "judges": {
          "kind": "array",
          "items": {
            "kind": "ref",
            "entity": "Judge",
            "description": "A judge."
          },
          "description": "Every judge. Codes only on the admin actions."
        },
        "teams": {
          "kind": "array",
          "items": {
            "kind": "ref",
            "entity": "JudgingTeam",
            "description": "A team."
          },
          "description": "Every team. Codes only on the admin actions."
        }
      }
    },
    "JudgingInfo": {
      "name": "JudgingInfo",
      "description": "What anyone may see before logging in.",
      "fields": {
        "settings": {
          "kind": "object",
          "fields": {
            "eventName": {
              "kind": "string",
              "description": "Display name."
            },
            "phase": {
              "kind": "enum",
              "values": [
                "submission",
                "prelim",
                "finals",
                "closed"
              ],
              "description": "Current phase."
            }
          },
          "description": "Name and phase only."
        },
        "links": {
          "kind": "array",
          "items": {
            "kind": "ref",
            "entity": "JudgingLink",
            "description": "A link."
          },
          "description": "Home-page links, in order."
        }
      }
    },
    "JudgingSettings": {
      "name": "JudgingSettings",
      "description": "Event phase and switches. Part of JudgingEvent. The backend enforces `phase`, `lockSubmissions`, `maxImages`, `finalsTeamIds`, `finalsJudgeIds`, `showTeamFeedback` and `allowJudgeSeeOthers`; the rest is stored for the portal.",
      "fields": {
        "eventName": {
          "kind": "string",
          "description": "Display name, e.g. `HelloHacks 2027`."
        },
        "phase": {
          "kind": "enum",
          "values": [
            "submission",
            "prelim",
            "finals",
            "closed"
          ],
          "description": "`submission`: teams edit their entries. `prelim`: judges score. `finals`: finals judges score finalist teams. `closed`: nothing changes."
        },
        "finalsTeamIds": {
          "kind": "array",
          "items": {
            "kind": "string",
            "description": "Team id."
          },
          "description": "Teams in the finals round. Empty until finals are set up."
        },
        "finalsJudgeIds": {
          "kind": "array",
          "items": {
            "kind": "string",
            "description": "Judge id."
          },
          "description": "Judges who score finals. Empty until finals are set up."
        },
        "showTeamFeedback": {
          "kind": "boolean",
          "description": "Teams may read their own reviews. When false, `reviews.list` with a team code is 403."
        },
        "allowJudgeSeeOthers": {
          "kind": "boolean",
          "description": "Judges may read other judges' reviews. When false, `reviews.list` returns a judge only their own."
        },
        "anonymizeTeams": {
          "kind": "boolean",
          "description": "Hide team names from judges. A UI concern; the API still returns names."
        },
        "lockSubmissions": {
          "kind": "boolean",
          "description": "Teams may no longer edit their entries, regardless of phase."
        },
        "maxImages": {
          "kind": "integer",
          "description": "Maximum screenshots per team, enforced on `team.update`."
        },
        "perTeamJudges": {
          "kind": "integer",
          "optional": true,
          "description": "How many judges the portal's auto-assign gives each team. Stored, not enforced."
        },
        "finalsTopN": {
          "kind": "integer",
          "optional": true,
          "description": "How many prelim teams the portal advances to finals by default. Stored, not enforced."
        },
        "schedule": {
          "kind": "ref",
          "entity": "JudgingSchedule",
          "optional": true,
          "description": "Prelim presentation schedule. Absent until the portal creates one."
        }
      }
    },
    "JudgingSchedule": {
      "name": "JudgingSchedule",
      "description": "Prelim presentation schedule kept by the portal: rooms of judges, timed blocks, and which team presents in which room during which block. Stored inside settings; the backend does not interpret it. The portal derives each judge's `assignedTeamIds` from their room.",
      "fields": {
        "rooms": {
          "kind": "array",
          "items": {
            "kind": "object",
            "fields": {
              "id": {
                "kind": "string",
                "description": "Chosen by the portal."
              },
              "name": {
                "kind": "string",
                "description": "Room name, e.g. `Room A`."
              },
              "judgeIds": {
                "kind": "array",
                "items": {
                  "kind": "string",
                  "description": "Judge id."
                },
                "description": "Judges who sit in this room for every block."
              },
              "usher": {
                "kind": "string",
                "optional": true,
                "description": "Name of the volunteer who runs the room, shown to teams on the display board instead of the judges."
              }
            },
            "description": "A room."
          },
          "description": "Rooms, in display order."
        },
        "blocks": {
          "kind": "array",
          "items": {
            "kind": "object",
            "fields": {
              "id": {
                "kind": "string",
                "description": "Chosen by the portal."
              },
              "label": {
                "kind": "string",
                "description": "Display label, e.g. `Block 1`."
              },
              "startsAt": {
                "kind": "string",
                "description": "Start time as entered, e.g. `13:00`."
              }
            },
            "description": "A block: every room judges at the same time."
          },
          "description": "Blocks, in time order."
        },
        "slots": {
          "kind": "array",
          "items": {
            "kind": "object",
            "fields": {
              "blockId": {
                "kind": "string",
                "description": "Block id."
              },
              "roomId": {
                "kind": "string",
                "description": "Room id."
              },
              "teamId": {
                "kind": "string",
                "description": "Team id."
              }
            },
            "description": "One team presenting in one room during one block."
          },
          "description": "Every scheduled presentation."
        },
        "activeBlockId": {
          "kind": "string",
          "optional": true,
          "description": "The block organizers have marked as happening now. Absent until one is set."
        },
        "changes": {
          "kind": "array",
          "items": {
            "kind": "object",
            "fields": {
              "at": {
                "kind": "string",
                "description": "ISO-8601, when the organizer saved."
              },
              "message": {
                "kind": "string",
                "description": "What moved, e.g. `Team X: Block 1 / Room A → Block 2 / Room A`."
              }
            },
            "description": "One logged change."
          },
          "description": "Newest first. The portal keeps the last 200."
        }
      }
    },
    "Rubric": {
      "name": "Rubric",
      "description": "What judges score against. Reviews carry one score per criterion; totals are computed from this.",
      "fields": {
        "name": {
          "kind": "string",
          "description": "Rubric name."
        },
        "scaleMax": {
          "kind": "integer",
          "description": "Highest score on a criterion unless it sets `maxScore`."
        },
        "scoreMode": {
          "kind": "enum",
          "values": [
            "points",
            "weighted"
          ],
          "description": "`points`: total is the sum of raw scores. `weighted`: each score is multiplied by its criterion's weight."
        },
        "criteria": {
          "kind": "array",
          "items": {
            "kind": "object",
            "fields": {
              "id": {
                "kind": "string",
                "description": "Stable id; the key in Review.scores. Unique within the rubric."
              },
              "label": {
                "kind": "string",
                "description": "Short name shown to judges."
              },
              "description": {
                "kind": "string",
                "optional": true,
                "description": "Guidance shown under the label."
              },
              "weight": {
                "kind": "number",
                "description": "Multiplier in `weighted` mode; 1 is neutral."
              },
              "maxScore": {
                "kind": "integer",
                "optional": true,
                "description": "Overrides scaleMax for this criterion."
              }
            },
            "description": "One criterion."
          },
          "description": "Criteria in display order."
        }
      }
    },
    "JudgingTeam": {
      "name": "JudgingTeam",
      "description": "A team being judged. Lives inside JudgingEvent; logs in to its own pages with `code`.",
      "fields": {
        "id": {
          "kind": "string",
          "description": "Assigned by the backend."
        },
        "name": {
          "kind": "string",
          "description": "Team name."
        },
        "members": {
          "kind": "array",
          "items": {
            "kind": "string",
            "description": "Member name."
          },
          "description": "Member display names."
        },
        "description": {
          "kind": "string",
          "optional": true,
          "description": "Project pitch."
        },
        "github": {
          "kind": "string",
          "optional": true,
          "description": "Repository URL."
        },
        "devpost": {
          "kind": "string",
          "optional": true,
          "description": "Devpost URL."
        },
        "imageUrls": {
          "kind": "array",
          "items": {
            "kind": "string",
            "description": "Image URL."
          },
          "optional": true,
          "description": "Screenshots, as URLs. At most `settings.maxImages`."
        },
        "code": {
          "kind": "string",
          "optional": true,
          "description": "Login code for the team's own pages. Only in `admin.get` and `admin.set` responses; minted by the backend when absent."
        }
      }
    },
    "Judge": {
      "name": "Judge",
      "description": "A judge for one event. No BizTech account; logs in with `code`.",
      "fields": {
        "id": {
          "kind": "string",
          "description": "Assigned by the backend."
        },
        "name": {
          "kind": "string",
          "description": "Display name, shown on reviews."
        },
        "assignedTeamIds": {
          "kind": "array",
          "items": {
            "kind": "string",
            "description": "Team id."
          },
          "optional": true,
          "description": "Teams this judge scores in prelims, in order. Chosen by the portal; not enforced by the backend."
        },
        "code": {
          "kind": "string",
          "optional": true,
          "description": "Login code. Only in `admin.get` and `admin.set` responses; minted by the backend when absent."
        }
      }
    },
    "JudgingLink": {
      "name": "JudgingLink",
      "description": "A link on the portal home page (schedule, Discord, rules).",
      "fields": {
        "id": {
          "kind": "string",
          "description": "Chosen by the portal."
        },
        "label": {
          "kind": "string",
          "description": "Link text."
        },
        "url": {
          "kind": "string",
          "description": "Destination."
        }
      }
    },
    "JudgingPrincipal": {
      "name": "JudgingPrincipal",
      "description": "Who a code belongs to. Returned as `me` by `judging.get`. Organizers are not principals; they are Cognito admins.",
      "fields": {
        "role": {
          "kind": "enum",
          "values": [
            "judge",
            "team"
          ],
          "description": "What the code grants."
        },
        "id": {
          "kind": "string",
          "description": "Judge id or team id."
        },
        "name": {
          "kind": "string",
          "description": "Display name."
        }
      }
    },
    "Review": {
      "name": "Review",
      "description": "One judge's scores for one team in one round. Resubmitting replaces it.",
      "fields": {
        "id": {
          "kind": "string",
          "description": "`<round>__<teamId>__<judgeId>`."
        },
        "round": {
          "kind": "enum",
          "values": [
            "prelim",
            "finals"
          ],
          "description": "Round the review belongs to; the phase at submission."
        },
        "teamId": {
          "kind": "string",
          "description": "JudgingTeam id."
        },
        "judgeId": {
          "kind": "string",
          "description": "Judge id."
        },
        "judgeName": {
          "kind": "string",
          "description": "Judge display name at submission."
        },
        "scores": {
          "kind": "record",
          "values": {
            "kind": "number",
            "description": "Score for the criterion."
          },
          "description": "Keyed by Rubric.criteria[].id."
        },
        "feedback": {
          "kind": "string",
          "description": "Written feedback. Empty string when none."
        },
        "total": {
          "kind": "number",
          "description": "Sum of raw scores, computed by the backend."
        },
        "weightedTotal": {
          "kind": "number",
          "description": "Sum of score × weight, computed by the backend."
        },
        "completedAt": {
          "kind": "string",
          "description": "ISO-8601."
        }
      }
    }
  },
  "resources": {
    "judging": {
      "singular": "judging",
      "description": "The event's judging as one document. `bt.judging(e, y).info()` before login, `.get()` with a code (which is also login).",
      "entity": "JudgingEvent",
      "scope": {
        "name": "judging",
        "description": "One event's judging. Keyed like an event: (eventID, year).",
        "key": {
          "eventID": {
            "kind": "string",
            "description": "Event id (slug), e.g. `hellohacks`."
          },
          "year": {
            "kind": "integer",
            "description": "Event year."
          }
        }
      },
      "key": {},
      "collection": {},
      "instance": {
        "info": {
          "errors": {
            "EventNotFound": {
              "status": 404,
              "description": "No judging has been set up for this event. `admin.set` creates it."
            }
          },
          "description": "Event name, phase and links, for the landing page before anyone logs in. Sends no credential.",
          "auth": "public",
          "output": {
            "kind": "ref",
            "entity": "JudgingInfo",
            "description": "Name, phase, links."
          },
          "route": {
            "method": "GET",
            "path": "/judging/{eventID}/{year}"
          }
        },
        "get": {
          "errors": {
            "UnknownCode": {
              "status": 401,
              "description": "The code matches no judge or team of this event (or no judging exists for it yet)."
            }
          },
          "description": "The whole document as the code may see it, plus `me`. Judge and team codes are never included. This is also login: send the code and a 401 means it is not recognized.",
          "auth": "judgingCode",
          "output": {
            "kind": "ref",
            "entity": "JudgingEvent",
            "description": "The document, with `me`."
          },
          "route": {
            "method": "GET",
            "path": "/judging/{eventID}/{year}"
          }
        }
      },
      "links": {}
    },
    "judgingAdmin": {
      "singular": "admin",
      "description": "Organizer actions, with a Cognito token. `bt.judging(e, y).admin.get()` reads the document with every code, `.set()` replaces it, `.reviews()` lists every review.",
      "entity": "JudgingEvent",
      "scope": {
        "name": "judging",
        "description": "One event's judging. Keyed like an event: (eventID, year).",
        "key": {
          "eventID": {
            "kind": "string",
            "description": "Event id (slug), e.g. `hellohacks`."
          },
          "year": {
            "kind": "integer",
            "description": "Event year."
          }
        }
      },
      "key": {},
      "collection": {},
      "instance": {
        "get": {
          "errors": {
            "EventNotFound": {
              "status": 404,
              "description": "No judging has been set up for this event yet. `set` creates it."
            },
            "Forbidden": {
              "status": 403,
              "description": "The token is valid but its account is not a BizTech admin."
            }
          },
          "description": "The whole document including every judge and team code. No `me`.",
          "auth": "admin",
          "output": {
            "kind": "ref",
            "entity": "JudgingEvent",
            "description": "The document with every code."
          },
          "route": {
            "method": "GET",
            "path": "/judging/{eventID}/{year}/admin"
          }
        },
        "set": {
          "errors": {
            "InvalidInput": {
              "status": 406,
              "description": "A required field is missing, the phase is not one of the four, or two rubric criteria share an id."
            },
            "Forbidden": {
              "status": 403,
              "description": "The token is valid but its account is not a BizTech admin."
            }
          },
          "description": "Replace the whole document, creating it if needed. Judges and teams without an `id` or `code` get one minted; pass existing ones back to keep them. The response includes every code. Last write wins.",
          "auth": "admin",
          "input": {
            "settings": {
              "kind": "ref",
              "entity": "JudgingSettings",
              "description": "Phase and switches."
            },
            "rubric": {
              "kind": "ref",
              "entity": "Rubric",
              "optional": true,
              "nullable": true,
              "description": "The rubric. Omit or null for none."
            },
            "links": {
              "kind": "array",
              "items": {
                "kind": "ref",
                "entity": "JudgingLink",
                "description": "A link."
              },
              "description": "Home-page links."
            },
            "judges": {
              "kind": "array",
              "items": {
                "kind": "object",
                "fields": {
                  "id": {
                    "kind": "string",
                    "optional": true,
                    "description": "Keep an existing judge's id; omit for a new one."
                  },
                  "name": {
                    "kind": "string",
                    "description": "Display name, shown on reviews."
                  },
                  "assignedTeamIds": {
                    "kind": "array",
                    "items": {
                      "kind": "string",
                      "description": "Team id."
                    },
                    "optional": true,
                    "description": "Teams this judge scores in prelims, in order. Chosen by the portal; not enforced by the backend."
                  },
                  "code": {
                    "kind": "string",
                    "optional": true,
                    "description": "Keep an existing judge's code; omit to mint one."
                  }
                },
                "description": "A judge."
              },
              "description": "Every judge."
            },
            "teams": {
              "kind": "array",
              "items": {
                "kind": "object",
                "fields": {
                  "id": {
                    "kind": "string",
                    "optional": true,
                    "description": "Keep an existing team's id; omit for a new one."
                  },
                  "name": {
                    "kind": "string",
                    "description": "Team name."
                  },
                  "members": {
                    "kind": "array",
                    "items": {
                      "kind": "string",
                      "description": "Member name."
                    },
                    "description": "Member display names."
                  },
                  "description": {
                    "kind": "string",
                    "optional": true,
                    "description": "Project pitch."
                  },
                  "github": {
                    "kind": "string",
                    "optional": true,
                    "description": "Repository URL."
                  },
                  "devpost": {
                    "kind": "string",
                    "optional": true,
                    "description": "Devpost URL."
                  },
                  "imageUrls": {
                    "kind": "array",
                    "items": {
                      "kind": "string",
                      "description": "Image URL."
                    },
                    "optional": true,
                    "description": "Screenshots, as URLs. At most `settings.maxImages`."
                  },
                  "code": {
                    "kind": "string",
                    "optional": true,
                    "description": "Keep an existing team's code; omit to mint one."
                  }
                },
                "description": "A team."
              },
              "description": "Every team."
            }
          },
          "output": {
            "kind": "ref",
            "entity": "JudgingEvent",
            "description": "The stored document with every code."
          },
          "route": {
            "method": "PUT",
            "path": "/judging/{eventID}/{year}"
          }
        },
        "reviews": {
          "errors": {
            "Forbidden": {
              "status": 403,
              "description": "The token is valid but its account is not a BizTech admin."
            }
          },
          "description": "Every review of the event, newest first, with optional filters.",
          "auth": "admin",
          "input": {
            "round": {
              "kind": "enum",
              "values": [
                "prelim",
                "finals"
              ],
              "optional": true,
              "description": "Restrict to a round."
            },
            "teamId": {
              "kind": "string",
              "optional": true,
              "description": "Restrict to a team."
            },
            "judgeId": {
              "kind": "string",
              "optional": true,
              "description": "Restrict to a judge."
            }
          },
          "output": {
            "kind": "array",
            "items": {
              "kind": "ref",
              "entity": "Review",
              "description": "A review."
            },
            "description": "Matching reviews, newest first."
          },
          "route": {
            "method": "GET",
            "path": "/judging/{eventID}/{year}/admin/reviews",
            "query": [
              "round",
              "teamId",
              "judgeId"
            ]
          }
        }
      },
      "links": {}
    },
    "judgingTeam": {
      "singular": "team",
      "description": "One team. `bt.judging(e, y).team(id).update(…)` is the team editing its own entry; `.review(…)` is a judge scoring it. Organizers edit teams through `admin.set`.",
      "entity": "JudgingTeam",
      "scope": {
        "name": "judging",
        "description": "One event's judging. Keyed like an event: (eventID, year).",
        "key": {
          "eventID": {
            "kind": "string",
            "description": "Event id (slug), e.g. `hellohacks`."
          },
          "year": {
            "kind": "integer",
            "description": "Event year."
          }
        }
      },
      "key": {
        "id": {
          "kind": "string",
          "description": "Team id."
        }
      },
      "collection": {},
      "instance": {
        "update": {
          "errors": {
            "UnknownCode": {
              "status": 401,
              "description": "The code matches no judge or team of this event (or no judging exists for it yet)."
            },
            "Forbidden": {
              "status": 403,
              "description": "The code belongs to a different team, or to a judge."
            },
            "TeamNotFound": {
              "status": 404,
              "description": "No such team."
            },
            "InvalidInput": {
              "status": 406,
              "description": "`name` or `members` is missing."
            },
            "SubmissionsClosed": {
              "status": 409,
              "description": "Phase is past `submission`, `lockSubmissions` is on, or there are more than `maxImages` images."
            }
          },
          "description": "Replace the team's editable fields. Only the team's own code, while the phase is `submission` and submissions are not locked.",
          "auth": "judgingCode",
          "input": {
            "name": {
              "kind": "string",
              "description": "Team name."
            },
            "members": {
              "kind": "array",
              "items": {
                "kind": "string",
                "description": "Member name."
              },
              "description": "Member display names."
            },
            "description": {
              "kind": "string",
              "optional": true,
